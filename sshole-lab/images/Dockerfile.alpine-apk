# Alpine target using the distro package.
#   SSH_PKG=openssh-server      -> current (fixed) non-PAM package  => PATCHED
#   SSH_PKG=openssh-server-pam  -> PAM build, LAB_USE_PAM=yes        => NOT AFFECTED
ARG ALPINE_VERSION=3.22
FROM alpine:${ALPINE_VERSION}
ARG SSH_PKG=openssh-server
ARG LAB_USE_PAM=no
RUN apk upgrade --no-cache && apk add --no-cache "${SSH_PKG}"
COPY keys/lab_ed25519.pub /tmp/lab_ed25519.pub
COPY images/lab-setup.sh images/entrypoint.sh /usr/local/sbin/
RUN chmod +x /usr/local/sbin/*.sh && LAB_USE_PAM="${LAB_USE_PAM}" /usr/local/sbin/lab-setup.sh
EXPOSE 22
ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
