# glibc control target: Debian OpenSSH  => NOT AFFECTED
FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd /root/.ssh && chmod 700 /root/.ssh
COPY keys/lab_ed25519.pub /root/.ssh/authorized_keys
COPY images/entrypoint.sh /usr/local/sbin/entrypoint.sh
RUN chmod 600 /root/.ssh/authorized_keys && chmod +x /usr/local/sbin/entrypoint.sh \
 && sed -i '1i PasswordAuthentication yes' /etc/ssh/sshd_config
EXPOSE 22
ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
